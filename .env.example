NODE_ENV=development
PORT=5000
TRUST_PROXY=1
AUTO_RUN_MIGRATIONS=true
AUTO_RUN_MIGRATIONS_STRICT=true
AUTO_BACKFILL_TOILET_QR_ON_BOOT=true

# API
# Supports exact values and wildcard patterns (e.g. https://*.vercel.app)
# Important: do not add trailing slash to origins (use https://my-app.vercel.app, not ...app/)
# Example prod-safe list:
# http://localhost:*,http://127.0.0.1:*,https://greentoilet-aially.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:*,http://127.0.0.1:*,https://greentoilet-aially.vercel.app,https://*.vercel.app
JSON_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_MAX=5000
REQUEST_LOGGING_ENABLED=true
REQUEST_LOGGING_VERBOSE=false

# PostgreSQL (prefer DATABASE_URL; split values are fallback)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sanitation_solution
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanitation_solution
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_STARTUP_MAX_ATTEMPTS=4
DB_STARTUP_RETRY_DELAY_MS=2000
# Public QR landing URL for citizen feedback form
# If this is set, protocol/host/port below are ignored.
PUBLIC_FEEDBACK_BASE_URL=http://localhost:5000
PUBLIC_FEEDBACK_PROTOCOL=http
PUBLIC_FEEDBACK_HOST=localhost
PUBLIC_FEEDBACK_PORT=5000

# JWT / session
JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TTL_MS=900000

# Cloudinary (optional; local storage used if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_FILE_SIZE=8388608

# AWS S3 (optional; for media storage)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sanitation-s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Keep empty or "private". Public ACLs are blocked when S3_ENFORCE_PRIVATE_ACL=true.
AWS_S3_OBJECT_ACL=
# Default "locator" stores s3://bucket/key in DB, then API resolves to presigned GET URLs.
# Set to "public" only if you explicitly want direct object URLs.
S3_MEDIA_URL_MODE=locator
S3_ENFORCE_PRIVATE_ACL=true
# Server-side encryption for all uploads (AES256 or aws:kms).
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
# Required when AWS_S3_SERVER_SIDE_ENCRYPTION=aws:kms.
AWS_S3_KMS_KEY_ID=
AWS_S3_BUCKET_KEY_ENABLED=true
# Keep false in production so uploads never fall back to public local storage.
S3_FALLBACK_TO_LOCAL=false
S3_PRESIGNED_URL_TTL_SEC=900
S3_PRESIGNED_GET_TTL_SEC=900

# Redis / queue (optional; inline fallback when disabled)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_LIVE_CHANNEL=sanitation:live:events
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
QUEUE_WORKER_CONCURRENCY=2
ANALYSIS_WORKER_CONCURRENCY=2
ANALYSIS_INLINE_CONCURRENCY=6
ANALYSIS_WORKER_EMBEDDED=true
ANALYSIS_QUEUE_ATTEMPTS=4
ANALYSIS_QUEUE_BACKOFF_MS=1200
ANALYSIS_QUEUE_REMOVE_COMPLETE=200
IDEMPOTENCY_LOCK_MS=60000
IDEMPOTENCY_TTL_MS=86400000

# Live stream
SSE_HEARTBEAT_MS=20000
WS_HEARTBEAT_MS=25000

# Analysis adapter
ANALYSIS_PROVIDER=openai
ANALYSIS_TRIGGER_ON_UPLOAD=true
ANALYSIS_BOOT_STRICT=false
OPENAI_API_KEY=replace_with_openai_key
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_ANALYSIS_TIMEOUT_MS=45000
OPENAI_ANALYSIS_MAX_IMAGES=4
OPENAI_BASE_URL=https://api.openai.com/v1
ANALYSIS_CONFIDENCE_THRESHOLD=0.70
ANALYSIS_MIN_AUTO_ACCEPT_SCORE=45
ANALYSIS_REVIEW_CONFIDENCE_THRESHOLD=0.60
ANALYSIS_REJECT_CONFIDENCE_THRESHOLD=0.40
ANALYSIS_BLUR_VARIANCE_MIN=120
ANALYSIS_BRIGHTNESS_MIN=35
ANALYSIS_BRIGHTNESS_MAX=220
ANALYSIS_VALIDATION_MAX_DIMENSION=768
ANALYSIS_FRAUD_SIMILARITY_THRESHOLD=0.92

# Sensor alert thresholds
ALERT_ODOR_PPM_THRESHOLD=70
ALERT_AMMONIA_PPM_THRESHOLD=35
ALERT_H2S_PPM_THRESHOLD=10
ALERT_METHANE_PPM_THRESHOLD=90

# Sensor simulator
SIM_API_BASE_URL=http://localhost:5000/api/v1
SIM_USERNAME=superadmin@platform.gov
SIM_PASSWORD=Password@123
SIM_INTERVAL_MS=5000
SIM_DEVICE_LIMIT=10
