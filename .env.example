# ============================================================
# Sanitation Backend Environment (Minimal)
# DEV: copy to .env and keep development defaults
# PROD: switch values marked below before deploying on EC2
# ============================================================

# --- Core runtime ---
# DEV: development | PROD: production
NODE_ENV=development
# DEV/PROD: backend listen port
PORT=5000
# DEV: 0 or 1 | PROD: 1 when behind Nginx/ALB
TRUST_PROXY=1

# --- Logging ---
# DEV: debug/info | PROD: info/warn
LOG_LEVEL=info
# DEV/PROD: service tag in structured logs
LOG_SERVICE_NAME=sanitation-backend
# DEV: pretty (default) short colored lines | PROD: json (default) one-line JSON for aggregators
# Override: LOG_FORMAT=pretty | LOG_FORMAT=json
# LOG_FORMAT=pretty

# --- API / CORS / docs ---
# DEV: local frontend origin(s) | PROD: exact allowed domains only
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# DEV: false (preferred) | PROD: false
CORS_ALLOW_ALL=false
# DEV: true if needed | PROD: false
API_DOCS_ENABLED=true
# DEV: true for local file serving | PROD: false when S3 is used
LOCAL_MEDIA_SERVE_ENABLED=true
# DEV: optional | PROD: public backend base URL
API_PUBLIC_BASE_URL=http://localhost:5000
# DEV: optional | PROD: public feedback base URL (must point to backend host, not frontend host)
PUBLIC_FEEDBACK_BASE_URL=http://localhost:5000
# Optional: explicit base URL used when generating app update APK links
# Keep this as scheme+host(+port) only, no /api/v1 suffix.
APP_API_BASE_URL=http://localhost:5000
# Optional: override app update config/apk paths (relative to backend root)
APP_UPDATE_CONFIG_PATH=./app-update.json
APP_UPDATE_APK_DIR=./apk
# DEV/PROD: request JSON limit
JSON_BODY_LIMIT=2mb
# DEV/PROD: global API rate-limit window
RATE_LIMIT_WINDOW_MS=60000
# DEV/PROD: global API rate-limit max requests per window
RATE_LIMIT_MAX=300
# DEV/PROD: supervisor-only API cap (after auth), per user id — avoids one office IP starving the UI
SUPERVISOR_RATE_LIMIT_MAX=2000

# --- Server timeouts ---
# DEV/PROD: request timeout
SERVER_REQUEST_TIMEOUT_MS=120000
# DEV/PROD: graceful shutdown timeout
GRACEFUL_SHUTDOWN_TIMEOUT_MS=25000

# --- Database (required) ---
# DEV: local/supabase URL | PROD: RDS/managed Postgres URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sanitation_solution
# DEV: false for local PG | PROD: true for hosted DB
DB_SSL=false
# DEV/PROD: DB pool max
DB_POOL_MAX=20
# DEV/PROD: DB pool min
DB_POOL_MIN=2
# DEV/PROD: DB query timeout
DB_QUERY_TIMEOUT_MS=15000

# --- Auth (required) ---
# DEV: strong random secret | PROD: strong random secret (required)
JWT_SECRET=replace_with_strong_secret
# DEV: strong random secret | PROD: different strong random secret (required)
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
# DEV/PROD: access token TTL
JWT_ACCESS_EXPIRES_IN=15m
# DEV/PROD: refresh token TTL
JWT_REFRESH_EXPIRES_IN=30d
# DEV/PROD: password reset token TTL (ms)
PASSWORD_RESET_TTL_MS=900000

# --- Media upload ---
# DEV/PROD: max upload size in bytes
MEDIA_MAX_FILE_SIZE=8388608
# DEV: true | PROD: true (janitor enabled)
TEMP_FILE_JANITOR_ENABLED=true

# --- AWS S3 (optional but recommended for PROD) ---
# DEV: region for test bucket | PROD: EC2 region
AWS_REGION=ap-south-1
# DEV/PROD: media bucket name
AWS_S3_BUCKET=your-s3-bucket
# DEV: optional static keys | PROD: prefer IAM role (leave empty if role-based)
AWS_ACCESS_KEY_ID=
# DEV: optional static secret | PROD: prefer IAM role (leave empty if role-based)
AWS_SECRET_ACCESS_KEY=
# DEV: optional | PROD: optional CDN/public S3 base URL
AWS_S3_PUBLIC_BASE_URL=
# DEV: true for local fallback | PROD: false
S3_FALLBACK_TO_LOCAL=false
# DEV/PROD: presigned PUT URL TTL in seconds
S3_PRESIGNED_URL_TTL_SEC=900

# --- Redis (optional, enables distributed queue/live features) ---
# DEV: false if no Redis | PROD: true if Redis is provisioned
REDIS_ENABLED=false
# DEV/PROD: Redis connection URL
REDIS_URL=redis://127.0.0.1:6379
#
# EC2 / PM2: If you run `sanitation-analysis-worker`, set REDIS_ENABLED=true and a
# reachable REDIS_URL, or remove that process from PM2 until Redis exists.
# Without Redis, the main API still runs; the standalone analysis worker waits and retries.
#
# If the browser hits HTTP 429 on many routes at once, check RATE_LIMIT_MAX is not set
# extremely low (default 300 per RATE_LIMIT_WINDOW_MS). A buggy client can also trip limits.

# --- AI Analysis (optional) ---
# DEV/PROD: currently openai
ANALYSIS_PROVIDER=openai
# DEV: true/false as needed | PROD: true only when AI key is configured
ANALYSIS_TRIGGER_ON_UPLOAD=true
# DEV: set real key if testing AI | PROD: required when trigger is true
OPENAI_API_KEY=
# DEV/PROD: model name
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# DEV/PROD: OpenAI API base URL
OPENAI_BASE_URL=https://api.openai.com/v1
# DEV/PROD: AI request timeout
OPENAI_ANALYSIS_TIMEOUT_MS=45000
# DEV/PROD: max images per analysis request
OPENAI_ANALYSIS_MAX_IMAGES=4

# --- AI Usage Tracking (optional) ---
# DEV/PROD: set to false to disable usage logging entirely
AI_USAGE_TRACKING_ENABLED=true
# DEV/PROD: static USD to INR conversion rate (update periodically)
USD_TO_INR_RATE=84.0

# --- Optional alt storage (Cloudinary) ---
# DEV/PROD: leave empty unless Cloudinary is used
CLOUDINARY_CLOUD_NAME=
# DEV/PROD: leave empty unless Cloudinary is used
CLOUDINARY_API_KEY=
# DEV/PROD: leave empty unless Cloudinary is used
CLOUDINARY_API_SECRET=

# --- Notifications / Firebase Push (backend only) ---
# DEV/PROD: Firebase project id
FIREBASE_PROJECT_ID=your-project-id
# DEV/PROD: Firebase service account client email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# DEV/PROD: Firebase service account private key (preserve \n escapes)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
# DEV/PROD: Optional path to service account JSON file (fallback)
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Critical complaint automation ---
# DEV/PROD: comma-separated values matched against complaint priority/type/status and toilet status
CRITICAL_COMPLAINT_VALUES=critical,emergency,very_bad,very bad
# DEV/PROD: unresolved complaint repeat trigger for the same toilet
CRITICAL_REPEATED_COMPLAINT_WINDOW_MINUTES=120
CRITICAL_REPEATED_COMPLAINT_THRESHOLD=3
# DEV/PROD: worker assignment controls
WORKER_LOCATION_FRESHNESS_MINUTES=30
WORKER_MAX_ACTIVE_TASKS=3
WORKER_LOW_BATTERY_THRESHOLD=20
WORKER_ASSIGNMENT_RADIUS_KM=10
# DEV/PROD: task reminder and SLA controls
TASK_ACCEPT_REMINDER_MINUTES=10
TASK_START_REMINDER_MINUTES=20
TASK_SLA_WARNING_MINUTES=15
TASK_REMINDER_JOB_INTERVAL_MS=60000
WORKER_OFFLINE_ESCALATION_MINUTES=45
SUPERVISOR_MAP_POLLING_INTERVAL_MS=30000
TASK_SLA_CRITICAL_MINUTES=60
TASK_SLA_HIGH_MINUTES=120
TASK_SLA_MEDIUM_MINUTES=240
TASK_SLA_LOW_MINUTES=480
