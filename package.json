{
  "name": "sanitation-solution-backend",
  "version": "2.0.0",
  "description": "Unified sanitation monitoring backend API",
  "main": "src/server.js",
  "scripts": {
    "build": "npm install --no-audit --no-fund",
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "worker:analysis": "node src/workers/analysis-worker.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo:all",
    "db:seed": "npm run db:seed:minimal && npm run db:seed:rbac && npm run db:seed:superadmin",
    "db:seed:minimal": "sequelize-cli db:seed --seed 20260327170000-seed-minimal-supabase.js",
    "db:seed:rbac": "sequelize-cli db:seed --seed 20260327180500-seed-rbac-live-users.js",
    "db:seed:superadmin": "sequelize-cli db:seed --seed 20260327220000-seed-super-admin-ops.js",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:verify": "node scripts/verify-db.js",
    "qr:backfill": "node scripts/backfill-toilet-qr.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "seed:simulator": "node scripts/sensor-simulator.js"
  },
  "keywords": [
    "sanitation",
    "government",
    "monitoring",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.61.2",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.4"
  }
}
